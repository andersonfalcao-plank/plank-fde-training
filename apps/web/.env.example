# Vercel sets these system variables on each deployment.
# Do not set them on a local machine. src/lib/config.ts uses fallbacks.
# VERCEL_ENV=preview
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_PROJECT_PRODUCTION_URL=

# Optional. The base URL of the Requests API, with no "/" at the end.
# The createRequestAction server action sends POST ${API_BASE_URL}/api/requests.
# A server-side fetch cannot use a relative URL, so the app needs a full URL.
# When it is not set, the app uses https://${VERCEL_PROJECT_PRODUCTION_URL}
# on Vercel, then http://localhost:3000 on a local machine.
# Set it when the dev server uses another port, for example:
# API_BASE_URL=http://localhost:3001
